    opentype: document.getElementById('q-opentype').value.trim(),
    // 기본 양식 전용 필드
    model: document.getElementById('p-model').value.trim(),
    goal: document.getElementById('p-goal').value.trim(),
    level: document.getElementById('p-level').value.trim(),
    core: getCheckedValues('p-core'),
    view: document.getElementById('p-view').value.trim(),
    // 개념 기반 학습 양식 전용 필드
    corekeyword: document.getElementById('q-corekeyword').value.trim(),
