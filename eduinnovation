function updateSyncStatus(ok){
  const badge = document.getElementById('sync-badge');
  const note = document.getElementById('sync-note');
  const now = new Date();
  const hh = String(now.getHours()).padStart(2,'0');
  const mm = String(now.getMinutes()).padStart(2,'0');
  const ss = String(now.getSeconds()).padStart(2,'0');
  if(ok){
    badge.className = 'sync-badge';
    badge.textContent = '🟢 실시간 공유 중';
  } else {
    badge.className = 'sync-badge offline';
    badge.textContent = '⚪ 동기화 확인 필요';
  }
  note.textContent = `마지막 동기화: ${hh}:${mm}:${ss}`;
}

async function syncFromStorage(){
  if(isSyncing) return;
  isSyncing = true;
  try{
    const entrySnapshot = await sharedRoot.child('entries').once('value');
    const remote = entrySnapshot.exists() ? Object.values(entrySnapshot.val()) : [];
    if(!editingId){
      entries = remote;
    }
    const planSnapshot = await sharedRoot.child('plans').once('value');
    const remotePlans = planSnapshot.exists() ? Object.values(planSnapshot.val()) : [];
    if(!editingPlanId){
      plans = remotePlans;
    }
    render();
    renderPlans();
    updateSyncStatus(true);
  } catch(err){
    updateSyncStatus(false);
  } finally{
    isSyncing = false;
  }
}

function startRealtimeSync(){
  sharedRoot.child('entries').on('value', snapshot => {
    if(!editingId) entries = snapshot.exists() ? Object.values(snapshot.val()) : [];
    render();
    renderPlans();
    updateSyncStatus(true);
  }, () => updateSyncStatus(false));
  sharedRoot.child('plans').on('value', snapshot => {
    if(!editingPlanId) plans = snapshot.exists() ? Object.values(snapshot.val()) : [];
    renderPlans();
    render();
    updateSyncStatus(true);
  }, () => updateSyncStatus(false));
}

document.getElementById('manual-refresh').addEventListener('click', () => {
  syncFromStorage();
});

