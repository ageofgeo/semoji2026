    standard: document.getElementById('q-standard').value.trim(),
    catKnowledge: document.getElementById('q-cat-knowledge').value.trim(),
    catProcess: document.getElementById('q-cat-process').value.trim(),
    catValue: document.getElementById('q-cat-value').value.trim(),
    competency: document.getElementById('q-competency').value.trim(),
