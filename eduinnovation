function excelXmlEscape(value){
  return String(value ?? '').replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&apos;'}[ch]));
}

function excelCell(value, styleId, type='String'){
  const style = styleId ? ` ss:StyleID="${styleId}"` : '';
  return `<Cell${style}><Data ss:Type="${type}">${excelXmlEscape(value)}</Data></Cell>`;
}

function excelSheet(name, headers, rows, widths){
  const columns = (widths || headers.map(() => 100)).map(w => `<Column ss:AutoFitWidth="0" ss:Width="${w}"/>`).join('');
  const headerRow = `<Row ss:Height="30">${headers.map(h => excelCell(h,'Header')).join('')}</Row>`;
  const bodyRows = rows.map(row => `<Row>${row.map((v,i) => excelCell(v, i === 0 ? 'Center' : 'Body', typeof v === 'number' ? 'Number' : 'String')).join('')}</Row>`).join('');
  return `<Worksheet ss:Name="${excelXmlEscape(name)}"><Table>${columns}${headerRow}${bodyRows}</Table><WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel"><FreezePanes/><FrozenNoSplit/><SplitHorizontal>1</SplitHorizontal><TopRowBottomPane>1</TopRowBottomPane><ProtectObjects>False</ProtectObjects><ProtectScenarios>False</ProtectScenarios></WorksheetOptions></Worksheet>`;
}

