<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<title>9월 18일 학부모 공개수업 일정</title>
<style>
  :root{
    --ink:#5a3b42;
    --paper:#fff5f7;
    --line:#f3d3dc;
    --accent:#e8899f;
    --accent-soft:#fce6ec;
    --amber:#d9738e;
    --amber-soft:#fbe0e8;
    --edit:#c65b78;
    --edit-soft:#fbdde6;
    --white:#ffffff;
    --muted:#b98a95;
    --grade-band:#fdeef2;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:'Pretendard','Apple SD Gothic Neo','Malgun Gothic',sans-serif;
    padding:32px 20px 60px;
  }
  .wrap{max-width:1120px;margin:0 auto;}

  header{
    display:flex;
    align-items:baseline;
    justify-content:space-between;
    border-bottom:2px solid var(--ink);
    padding-bottom:14px;
    margin-bottom:28px;
    flex-wrap:wrap;
    gap:8px;
  }
  header .title{
    font-size:26px;
    font-weight:800;
    letter-spacing:-0.5px;
  }
  header .title span{color:var(--accent);}
  header .sub{
    font-size:13px;
    color:var(--muted);
  }
  .date-badge{
    display:inline-flex;
    align-items:center;
    gap:6px;
    background:var(--amber-soft);
    color:var(--amber);
    font-weight:800;
    font-size:13px;
    padding:6px 14px;
    border-radius:20px;
  }

  .panel{
    background:var(--white);
    border:1px solid var(--line);
    border-radius:10px;
    padding:22px;
    margin-bottom:26px;
    transition:box-shadow .2s;
  }
  .panel.editing{
    border-color:var(--edit);
    box-shadow:0 0 0 3px var(--edit-soft);
  }
  .panel h2{
    font-size:15px;
    margin:0 0 16px;
    font-weight:700;
    display:flex;
    align-items:center;
    gap:8px;
  }
  .panel h2::before{
    content:"";
    width:6px;height:6px;
    background:var(--accent);
    border-radius:50%;
    display:inline-block;
  }
  .panel.editing h2::before{background:var(--edit);}
  .edit-flag{
    font-size:11.5px;
    font-weight:800;
    color:var(--edit);
    background:var(--edit-soft);
    padding:3px 9px;
    border-radius:20px;
    margin-left:2px;
  }

  .grid{
    display:grid;
    grid-template-columns:repeat(4, 1fr);
    gap:14px 16px;
  }
  @media (max-width:760px){
    .grid{grid-template-columns:repeat(2,1fr);}
  }
  .plan-grid{
    display:grid;
    grid-template-columns:repeat(2, 1fr);
    gap:14px 16px;
  }
  @media (max-width:760px){
    .plan-grid{grid-template-columns:1fr;}
  }
  .plan-grid .full{grid-column:1 / -1;}
  .field{display:flex;flex-direction:column;gap:6px;}
  .field label{
    font-size:12px;
    font-weight:600;
    color:var(--muted);
  }
  .field input, .field select, .field textarea{
    border:1px solid var(--line);
    border-radius:6px;
    padding:9px 10px;
    font-size:14px;
    font-family:inherit;
    background:#fffdf9;
    color:var(--ink);
  }
  .field textarea{resize:vertical;line-height:1.5;}
  .field input::placeholder,
  .field textarea::placeholder{
    color:var(--muted);
    opacity:.7;
    font-style:italic;
    font-weight:400;
  }
  .field input:focus, .field select:focus, .field textarea:focus{
    outline:none;
    border-color:var(--accent);
    box-shadow:0 0 0 3px var(--accent-soft);
  }
  .field.manual-entry > label{font-weight:900;color:var(--ink);}
  .field input:disabled,.field select:disabled{background:#edf2f5;color:#71818c;border-color:#d7e0e6;cursor:not-allowed;font-weight:700;}
  .field select{cursor:pointer;}
  .subfield-row{display:flex;gap:8px;}
  .subfield-row select{flex:1;}

  .period-toggle{
    display:flex;
    gap:8px;
  }
  .period-toggle button{
    flex:1;
    padding:9px 0;
    border:1px solid var(--line);
    border-radius:6px;
    background:#fffdf9;
    color:var(--muted);
    font-weight:700;
    font-size:14px;
  }
  .period-toggle button.active{
    background:var(--accent);
    border-color:var(--accent);
    color:#fff;
  }

  .actions{
    margin-top:18px;
    display:flex;
    justify-content:flex-end;
    gap:10px;
    flex-wrap:wrap;
  }
  button{
    font-family:inherit;
    cursor:pointer;
    border:none;
    border-radius:6px;
    font-weight:700;
    font-size:14px;
  }
  .btn-primary{
    background:var(--accent);
    color:#fff;
    padding:10px 22px;
  }
  .btn-primary:hover{background:#c96b83;}
  .btn-primary.is-editing{background:var(--edit);}
  .btn-primary.is-editing:hover{background:#a5495f;}
  .btn-ghost{
    background:transparent;
    color:var(--muted);
    border:1px solid var(--line);
    padding:10px 16px;
  }
  .btn-ghost:hover{border-color:var(--ink);color:var(--ink);}
  .btn-small{padding:6px 12px;font-size:12.5px;border-radius:6px;}

  table{
    width:100%;
    border-collapse:collapse;
    font-size:13.5px;
  }
  thead th{
    text-align:left;
    font-size:12px;
    color:var(--muted);
    font-weight:700;
    padding:10px 10px;
    border-bottom:2px solid var(--ink);
    white-space:nowrap;
  }
  tbody td{
    padding:12px 10px;
    border-bottom:1px solid var(--line);
    vertical-align:middle;
  }
  tbody tr:hover{background:#fbf9f3;}
  tbody tr.row-editing{background:var(--edit-soft);}
  .order-badge{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    width:24px;height:24px;
    border-radius:50%;
    background:var(--accent-soft);
    color:var(--accent);
    font-weight:800;
    font-size:12px;
  }
  .grade-class-cell{font-weight:700;white-space:nowrap;}
  .period-tag{
    display:inline-block;
    padding:3px 9px;
    border-radius:5px;
    background:var(--amber-soft);
    color:var(--amber);
    font-size:11.5px;
    font-weight:800;
  }
  .row-btns{display:flex;gap:4px;white-space:nowrap;flex-wrap:wrap;}
  .icon-btn{
    background:none;
    border:none;
    color:var(--muted);
    font-size:14px;
    padding:5px 8px;
    border-radius:5px;
  }
  .icon-btn:hover{background:var(--accent-soft);color:var(--accent);}
  .icon-btn.del:hover{background:#fbe6e4;color:#c0392b;}
  .empty{
    text-align:center;
    color:var(--muted);
    padding:40px 0;
    font-size:14px;
  }
  .count{
    font-size:12px;
    color:var(--muted);
    font-weight:600;
    margin-left:6px;
  }
  .grade-header td{
    background:var(--grade-band);
    padding:9px 10px;
    border-bottom:1px solid var(--line);
  }
  .grade-header-inner{
    display:flex;
    align-items:center;
    gap:8px;
    font-weight:800;
    font-size:13px;
    color:var(--edit);
  }
  .grade-header-inner .dot{
    width:8px;height:8px;
    border-radius:50%;
    background:var(--edit);
    display:inline-block;
  }
  .grade-header-inner .n{
    font-weight:600;
    font-size:11.5px;
    color:var(--muted);
  }

  .admin-btn{
    background:var(--white);
    border:1px solid var(--line);
    color:var(--muted);
    padding:7px 14px;
    border-radius:20px;
    font-size:12.5px;
    font-weight:700;
  }
  .admin-btn:hover{border-color:var(--edit); color:var(--edit);}
  .admin-btn.is-admin{
    background:var(--edit);
    border-color:var(--edit);
    color:#fff;
  }

  .sync-badge{
    display:inline-flex;
    align-items:center;
    gap:6px;
    font-size:12px;
    font-weight:700;
    color:#3a8a52;
    background:#e8f7ec;
    padding:6px 12px;
    border-radius:20px;
  }
  .sync-badge.offline{
    color:var(--muted);
    background:var(--accent-soft);
  }
  .sync-note{
    text-align:right;
    font-size:11.5px;
    color:var(--muted);
    margin:-14px 0 18px;
  }

  .deadline-banner{
    display:flex;
    align-items:center;
    gap:10px;
    padding:12px 18px;
    border-radius:10px;
    font-size:13.5px;
    font-weight:700;
    margin-bottom:22px;
  }
  .deadline-banner.open{
    background:var(--accent-soft);
    color:#a03a5b;
    border:1px solid var(--line);
  }
  .deadline-banner.closed{
    background:#fbdde6;
    color:var(--edit);
    border:1px solid var(--edit);
  }
  .deadline-banner .badge{
    font-size:11px;
    font-weight:800;
    padding:3px 10px;
    border-radius:20px;
    background:var(--white);
  }

  .locked-note{
    font-size:12px;
    color:var(--edit);
    font-weight:700;
    margin-top:10px;
    text-align:right;
  }

  .tabs{
    display:flex;
    gap:6px;
    margin-bottom:22px;
    border-bottom:1px solid var(--line);
  }
  .tab-btn{
    background:none;
    border:none;
    padding:10px 18px;
    font-size:14px;
    font-weight:700;
    color:var(--muted);
    border-bottom:3px solid transparent;
    margin-bottom:-1px;
  }
  .tab-btn:hover{color:var(--edit);}
  .tab-btn.active{
    color:var(--edit);
    border-bottom-color:var(--edit);
  }
  .tab-content{display:none;}
  .tab-content.active{display:block;}

  .status-badge{
    font-size:11px;
    font-weight:800;
    padding:3px 9px;
    border-radius:20px;
    white-space:nowrap;
    display:inline-block;
  }
  .status-badge.done{background:#e8f7ec;color:#3a8a52;}
  .status-badge.todo{background:var(--accent-soft);color:var(--edit);}

  .plan-updated-at{
    font-size:11px;
    color:var(--muted);
    margin-top:3px;
    white-space:nowrap;
  }
  .grade-pdf-bar{display:flex;gap:6px;flex-wrap:wrap;align-items:center;}
  .unlinked-panel{background:#fff8e9;border-color:#f0d9a0;margin-top:14px;}
  .unlinked-panel h2::before{background:#d99a2b;}
  .unlinked-note{font-size:12px;color:#8a6a1f;margin:-6px 0 12px;}
  .unlinked-toggle-header{cursor:pointer;user-select:none;}
  .unlinked-toggle-header:hover{color:#a3781a;}
  .unlinked-toggle-icon{
    display:inline-block;
    width:12px;
    font-size:11px;
    color:#a3781a;
    transition:transform .15s;
  }
  .unlinked-body{margin-top:4px;}

  .checkbox-group{display:flex;flex-wrap:wrap;gap:8px;}
  .chip{
    display:inline-flex;
    align-items:center;
    gap:6px;
    padding:7px 13px;
    border:1px solid var(--line);
    border-radius:20px;
    font-size:12.5px;
    font-weight:600;
    cursor:pointer;
    user-select:none;
    background:#fffdf9;
    color:var(--muted);
  }
  .chip input{margin:0;accent-color:var(--edit);}
  .chip.checked{
    background:var(--accent-soft);
    border-color:var(--accent);
    color:var(--edit);
    font-weight:800;
  }

  .plan-teacher-group{margin-bottom:24px;}
  .plan-teacher-group:last-child{margin-bottom:0;}
  .plan-teacher-header{
    display:flex;
    align-items:center;
    gap:8px;
    font-weight:800;
    font-size:14px;
    color:var(--edit);
    margin-bottom:10px;
    padding-bottom:6px;
    border-bottom:1px solid var(--line);
  }
  .plan-teacher-header .n{
    font-size:11.5px;
    font-weight:600;
    color:var(--muted);
  }
  .plan-card{
    border:1px solid var(--line);
    border-radius:10px;
    padding:14px 16px;
    margin-bottom:10px;
    background:#fffdfd;
  }
  .plan-card-top{
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    gap:10px;
    flex-wrap:wrap;
  }
  .plan-card-title{font-weight:700;font-size:14px;}
  .plan-card-meta{font-size:12px;color:var(--muted);margin-top:3px;}
  .plan-card-actions{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px;}

  .template-choice-group{
    display:flex;
    gap:10px;
    flex-wrap:wrap;
  }
  .template-choice-btn{
    flex:1;
    min-width:220px;
    text-align:left;
    background:#fffdf9;
    border:1px solid var(--line);
    border-radius:10px;
    padding:12px 14px;
    cursor:pointer;
    font-family:inherit;
  }
  .template-choice-btn:hover{border-color:var(--accent);}
  .template-choice-btn.active{
    border-color:var(--edit);
    background:var(--edit-soft);
    box-shadow:0 0 0 2px var(--edit-soft) inset;
  }
  .template-choice-btn.locked{
    cursor:not-allowed;
    opacity:.55;
  }
  .tc-title{font-weight:800;font-size:13.5px;color:var(--ink);}
  .template-choice-btn.active .tc-title{color:var(--edit);}
  .tc-desc{font-size:11.5px;color:var(--muted);margin-top:3px;line-height:1.4;}
  .template-lock-note{
    font-size:11.5px;
    color:var(--muted);
    margin-top:6px;
  }
  .cat-row{
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:8px;
  }
  @media (max-width:760px){
    .cat-row{grid-template-columns:1fr;}
  }
  .cat-row .subfield label{
    font-size:11px;
    font-weight:600;
    color:var(--muted);
    display:block;
    margin-bottom:4px;
  }
  .cat-row .subfield textarea{width:100%;}

  .field-disabled{opacity:.4;}
  .field-disabled input,
  .field-disabled select,
  .field-disabled textarea{
    background:#f1ecee;
    cursor:not-allowed;
  }
  .field-disabled .checkbox-group .chip{
    cursor:not-allowed;
  }

  .load-entry-box{
    max-width:460px;
    margin-bottom:18px;
  }
  .preview-modal{position:fixed;inset:0;z-index:9999;display:none;align-items:center;justify-content:center;padding:18px;background:rgba(55,38,43,.58);}
  .preview-modal.open{display:flex;}
  .preview-dialog{display:flex;flex-direction:column;width:min(980px,96vw);height:94vh;overflow:hidden;border-radius:12px;background:#f3f8fc;box-shadow:0 18px 55px rgba(0,0,0,.28);}
  .preview-toolbar{display:flex;align-items:center;gap:8px;padding:10px 14px;background:#fff;border-bottom:1px solid #c9dfed;}
  .preview-toolbar strong{color:#244b66;margin-right:auto;}
  .preview-toolbar button{padding:8px 14px;}
  .preview-frame{width:100%;height:100%;border:0;background:#dfe8ee;}
  .print-area{display:none;}
  @media print{
    @page{size:A4 portrait;margin:0;}
    body{margin:0!important;padding:0!important;background:#fff!important;}
    body.printing-plan .wrap,body.printing-plan .preview-modal{display:none!important;}
    body.printing-plan .print-area{display:block!important;width:210mm;min-height:297mm;margin:0 auto;padding:12mm;color:#1f2937;font-family:'Malgun Gothic','Apple SD Gothic Neo',sans-serif;}
    body.printing-plan .print-area.combined-print{padding:0;}
    .print-area h1{text-align:center;font-size:20px;margin:0 0 28px;}
    .print-area table{width:100%;border-collapse:collapse;margin-bottom:18px;background:#fff;border:2px solid #7fb3d5;}
    .print-area tr{break-inside:avoid;page-break-inside:avoid;}
    .print-area th,.print-area td{border:1px solid #9fc7e3;padding:9px 12px;font-size:13.5px;text-align:left;vertical-align:top;}
    .print-area th{width:130px;background:#dceffc!important;color:#244b66;font-weight:700;white-space:nowrap;-webkit-print-color-adjust:exact;print-color-adjust:exact;}
    .print-area .wide{white-space:pre-wrap;}
    .print-area .section-title{margin:22px 0 8px;padding:8px 12px;border-left:4px solid #5b9cc6;background:#dceffc!important;color:#244b66;font-size:14px;font-weight:800;break-inside:avoid;-webkit-print-color-adjust:exact;print-color-adjust:exact;}
    .print-area .example-guide{color:#b7bfc7;font-size:11px;line-height:1.65;font-style:italic;}
    .print-area .flow-box{min-height:45mm;border:2px solid #7fb3d5;padding:12px;font-size:13.5px;line-height:1.65;white-space:pre-wrap;break-inside:auto;page-break-inside:auto;}
    .print-area .combined-plan-page{width:210mm;min-height:297mm;padding:12mm;break-after:page;page-break-after:always;}
    .print-area .combined-plan-page:last-child{break-after:auto;page-break-after:auto;}
  }
</style>
</head>
<body>
<div class="wrap">

  <header>
    <div>
      <div class="title">학부모 공개수업 <span>일정관리</span></div>
      <div class="sub">학년별로 구분되어 표시되며, 학년 · 학급 순서대로 자동 정렬됩니다 · 9월 14일(월) 16:30까지 입력 및 수정 가능</div>
    </div>
    <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
      <div class="date-badge">📅 2026년 9월 18일</div>
      <div class="sync-badge" id="sync-badge">🟢 실시간 공유 중</div>
      <button class="admin-btn" id="excel-export" title="입력한 모든 데이터를 Excel 파일로 정리">📊 엑셀로 정리</button>
      <button class="admin-btn" id="admin-toggle">🔒 관리자 모드</button>
    </div>
  </header>

  <div class="tabs">
    <button class="tab-btn active" id="tab-btn-register" data-tab="register">📋 일정 등록</button>
    <button class="tab-btn" id="tab-btn-plans" data-tab="plans">📝 교수학습과정안 작성</button>
  </div>

  <div id="tab-register" class="tab-content active">

  <div class="deadline-banner" id="deadline-banner"></div>
  <div class="sync-note" id="sync-note">마지막 동기화: -</div>

  <div class="panel" id="form-panel">
    <h2 id="form-title">수업공개 일정 등록</h2>
    <div style="font-size:12px; color:var(--muted); margin:-8px 0 16px;">* 모든 항목을 빠짐없이 입력해야 등록됩니다. 교수학습과정안은 옆 탭에서 화면으로 직접 작성합니다.</div>
    <div class="grid">
      <div class="field">
        <label>교사명</label>
        <input type="text" id="f-teacher" placeholder="교사명 입력">
      </div>
      <div class="field">
        <label>수업학년</label>
        <select id="f-grade">
          <option value="">선택</option>
          <option value="1">1학년</option>
          <option value="2">2학년</option>
          <option value="3">3학년</option>
          <option value="IB">IB과정</option>
        </select>
      </div>
      <div class="field">
        <label>학급</label>
        <select id="f-class">
          <option value="">선택</option>
          <option value="1">1반</option>
          <option value="2">2반</option>
          <option value="3">3반</option>
          <option value="4">4반</option>
          <option value="5">5반</option>
          <option value="6">6반</option>
          <option value="7">7반</option>
          <option value="IB">IB과정</option>
        </select>
      </div>
      <div class="field">
        <label>교과명</label>
        <select id="f-subject"></select>
      </div>
      <div class="field" id="f-subject-other-wrap" style="display:none;">
        <label>교과명 (직접 입력)</label>
        <input type="text" id="f-subject-other" placeholder="편제표에 없는 과목명 입력">
      </div>
      <div class="field" style="grid-column: span 2;">
        <label>수업주제</label>
        <input type="text" id="f-topic" placeholder="수업주제 입력">
      </div>
      <div class="field">
        <label>수업방법</label>
        <input type="text" id="f-method" placeholder="예) 모둠 협력학습">
      </div>
      <div class="field">
        <label>교시</label>
        <div class="period-toggle">
          <button type="button" id="btn-5" data-period="5교시" class="active">5교시</button>
          <button type="button" id="btn-6" data-period="6교시">6교시</button>
        </div>
      </div>
    </div>
    <div class="actions">
      <button class="btn-ghost" id="cancel-edit" style="display:none;">편집 취소</button>
      <button class="btn-ghost" id="clear-form">입력 지우기</button>
