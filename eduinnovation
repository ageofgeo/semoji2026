    updatedAt: Date.now(),
    createdAt: editingPlanId ? (plans.find(p => p.id === editingPlanId)?.createdAt || Date.now()) : Date.now()
  };

  const backup = plans.map(p => ({...p}));
  const idx = plans.findIndex(p => p.id === plan.id);
  if(idx >= 0){ plans[idx] = plan; } else { plans.push(plan); }

  renderPlans();
