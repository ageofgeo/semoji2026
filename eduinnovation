function findEmptyRequiredPlanFields(){
  const empty = [];
  const grid = document.querySelector('.plan-grid');
  const wraps = Array.from(grid.querySelectorAll(':scope > .field'));

  wraps.forEach(wrap => {
    // 비활성화(양식에 맞지 않아 회색 처리)되었거나 화면에 보이지 않는 항목은 건너뜁니다.
    if(wrap.classList.contains('field-disabled')) return;
    if(wrap.style.display === 'none') return;

    const rawLabel = (wrap.querySelector('label')?.textContent || '입력').replace(/[①②]/g,'').trim();

    // 학년/반 선택 (묶음 필드)
    const subfieldRow = wrap.querySelector(':scope > .subfield-row');
    if(subfieldRow){
      const gradeSel = wrap.querySelector('#p-grade');
      const classSel = wrap.querySelector('#p-class');
      if(gradeSel && !gradeSel.disabled && !gradeSel.value) empty.push({id:'p-grade', label:'수업 학년'});
      if(classSel && !classSel.disabled && !classSel.value) empty.push({id:'p-class', label:'학급'});
      return;
    }

    // 체크박스 그룹(핵심역량/세계시민)은 복수 선택 항목이라 필수 검사에서 제외합니다.
    if(wrap.querySelector('.checkbox-group')) return;

    // 범주(내용 요소)처럼 하위 입력이 여러 개인 경우
    const subfields = wrap.querySelectorAll('.subfield textarea, .subfield input');
    if(subfields.length){
      subfields.forEach(sf => {
        if(!sf.disabled && !sf.value.trim()){
          const sfLabel = sf.closest('.subfield')?.querySelector('label')?.textContent.trim() || rawLabel;
          empty.push({id: sf.id, label: `${rawLabel} - ${sfLabel}`});
        }
      });
      return;
    }

    const control = wrap.querySelector('input, select, textarea');
    if(!control || control.disabled) return;
    if(!control.value || !control.value.toString().trim()){
      empty.push({id: control.id, label: rawLabel});
    }
  });

  return empty;
}

