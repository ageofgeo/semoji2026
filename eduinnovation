function updateGradePdfButtons(){
  const container = document.getElementById('grade-pdf-buttons');
  if(!container) return;
  // 일정표에 아직 등록이 없어도 1학년/2학년/3학년/IB과정 아이콘은 항상 표시합니다.
  const grades = Object.keys(GRADE_ORDER).sort((a,b) => GRADE_ORDER[a] - GRADE_ORDER[b]);

  container.innerHTML = grades.map(g =>
    `<button type="button" class="btn-ghost btn-small grade-pdf-btn" data-grade="${g}" title="${gradeLabel(g)} 과정안만 학급순으로 모아 A4 PDF 미리보기">🖨️ ${gradeLabel(g)}</button>`
  ).join('');

  container.querySelectorAll('.grade-pdf-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      await syncFromStorage();
      const grade = btn.dataset.grade;
      const gradeEntries = entries
        .filter(e => e.grade === grade)
        .sort((a,b) => (CLASS_ORDER[a.cls] ?? 99) - (CLASS_ORDER[b.cls] ?? 99));
      const ordered = plansInScheduleOrder(gradeEntries);
      if(!ordered.length) return alert(`${gradeLabel(grade)}에 저장된 교수학습과정안이 없습니다. (일정표와 연결된 과정안만 출력됩니다)`);
      currentPreviewPlan = null;
      currentPreviewHtml = generateAllPlansDocumentHtml(ordered);
      document.getElementById('plan-preview-title').textContent = `${gradeLabel(grade)} 교수학습과정안 A4 미리보기 (${ordered.length}건)`;
      document.getElementById('plan-preview-frame').srcdoc = currentPreviewHtml;
      const modal = document.getElementById('plan-preview-modal');
      modal.classList.add('open'); modal.setAttribute('aria-hidden','false'); document.body.style.overflow = 'hidden';
    });
  });
}

function escapeHtml(str){
  return String(str || '').replace(/[&<>"']/g, ch => ({
    '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;'
  }[ch]));
}

function fmtDateKr(dateStr){
  if(!dateStr) return '';
  const d = new Date(dateStr + 'T00:00:00');
  if(isNaN(d.getTime())) return dateStr;
  const days = ['일','월','화','수','목','금','토'];
  return `${d.getFullYear()}. ${d.getMonth()+1}. ${d.getDate()}.(${days[d.getDay()]})`;
}

function checklistHtml(all, selected){
  return all.map(item => {
    const on = (selected || []).includes(item);
    return `<span style="display:inline-block;margin:2px 10px 2px 0;">${on ? '■' : '□'} ${escapeHtml(item)}</span>`;
  }).join('');
}

function nl2br(str){
  return escapeHtml(str).replace(/\n/g, '<br>');
}

function generatePlanDocumentHtml(p){
  return (p.template === 'concept') ? generateConceptPlanDocumentHtml(p) : generateBasicPlanDocumentHtml(p);
}

