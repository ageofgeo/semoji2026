function plansInScheduleOrder(entryList){
  // 공개수업 일정표(entries)와 연결된 과정안만, 학년·학급 순서(entries 정렬 순서)대로 반환합니다.
  // 일정표에서 삭제된 항목의 과정안은 여기 포함되지 않습니다.
  const list = entryList || entries;
  const ordered = [];
  const used = new Set();
  list.forEach(entry => {
    plans.filter(p => p.entryId === entry.id).sort((a,b) => b.updatedAt-a.updatedAt).forEach(p => {
      if(!used.has(p.id)){ordered.push(p);used.add(p.id);}
    });
  });
  return ordered;
}

function generateAllPlansDocumentHtml(orderedPlans){
  const first = generatePlanDocumentHtml(orderedPlans[0]);
  const head = first.match(/<head>[\s\S]*?<\/head>/i)?.[0] || '<head><meta charset="UTF-8"></head>';
  const pages = orderedPlans.map(p => {
    const html = generatePlanDocumentHtml(p);
    const body = html.match(/<body>([\s\S]*?)<\/body>/i)?.[1] || '';
    return `<section class="combined-plan-page">${body}</section>`;
  }).join('');
  const extraStyle = `<style>.combined-plan-page{width:100%;break-after:page;page-break-after:always}.combined-plan-page:last-child{break-after:auto;page-break-after:auto}@media screen{.combined-plan-page{margin-bottom:16px;padding-bottom:16px;border-bottom:2px dashed #9fc7e3}}</style>`;
  return `<!DOCTYPE html><html lang="ko">${head.replace('</head>',extraStyle+'</head>')}<body>${pages}</body></html>`;
}

